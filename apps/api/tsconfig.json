{
  "compilerOptions": {
    "target": "ESNext",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@hachi/database": ["../../packages/database/src"],
      "@hachi/database/*": ["../../packages/database/src/*"],
      "@hachi/schemas": ["../../packages/schemas/src"],
      "@hachi/schemas/*": ["../../packages/schemas/src/*"],
      "@hachi/mastra-core": ["../../packages/mastra-core/src"],
      "@hachi/mastra-core/*": ["../../packages/mastra-core/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
