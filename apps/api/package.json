    "@hachi/mastra-core": "workspace:*",
    "@hachi/schemas": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "lib0": "^0.2.98",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
